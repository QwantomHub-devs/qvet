# Local Supabase configuration (get values from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only secret key (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Q-Fellows Portal Integration (HMAC-SHA256 authenticated cross-platform bridge)
QFELLOWS_WEBHOOK_URL=http://localhost:3001/api/webhooks/qtalent
QFELLOWS_WEBHOOK_SECRET=your-shared-hmac-secret-for-qfellows
QFELLOWS_API_KEY=your-shared-api-key-for-qtalent

